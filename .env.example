# .env.example — AI Workstation Configuration
# Copy to .env and fill in your API keys:
#   cp .env.example .env && chmod 600 .env
#
# NEVER commit .env to git. It contains secrets.

# --- Required ---

# DeepSeek API key (primary model provider)
# Get one at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxx

# LiteLLM master key (protects your proxy endpoint)
# Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-litellm-xxx

# --- Optional (fallback providers) ---

# Alibaba DashScope / Qwen (secondary model)
# Get one at: https://www.alibabacloud.com/product/model-studio
DASHSCOPE_API_KEY=

# Anthropic Claude (premium fallback)
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI (premium fallback)
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini (long-context fallback)
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Paths ---

# Where your project repositories live on the host
WORKSPACE_PATH=/home/agent/projects

# --- Optional: Caddy (uncomment if using HTTPS) ---
# DOMAIN=workstation.example.com
