# Copy to ops/remote-desktop/.env and fill in local-only secrets.

REMOTE_DESKTOP_ENABLED=true

# Guacamole webapp binding. Keep this on localhost unless a Tailscale-only
# listener or authenticated dashboard proxy is intentionally configured.
GUACAMOLE_HOST=127.0.0.1
GUACAMOLE_BIND_HOST=127.0.0.1
GUACAMOLE_PORT=8080
GUACAMOLE_URL=/guacamole/
GUACAMOLE_VERSION=1.5.5
GUACAMOLE_RDP_COLOR_DEPTH=16
GUACAMOLE_AUTO_LOGIN_ENABLED=true
GUACAMOLE_USERNAME=guacadmin
GUACAMOLE_PASSWORD=replace-with-local-guacamole-web-password
GUACAMOLE_CONNECTION_ID=1

# Guacamole database. Replace this before first startup.
POSTGRES_DB=guacamole
POSTGRES_USER=guacamole
POSTGRES_PASSWORD=replace-with-local-guacamole-db-password

# xRDP target. RDP_PASSWORD must be set only in the local .env file.
RDP_HOST=dev-server
RDP_PORT=3389
RDP_USERNAME=agent
RDP_PASSWORD=
